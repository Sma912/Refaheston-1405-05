# Demo / UI review mode (no Supabase/Bale required)
NEXT_PUBLIC_DEMO_MODE=true

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Bale Safir OTP (Edge Function / API secrets)
BALE_API_ACCESS_KEY=
BALE_BOT_ID=
BALE_OTP_BASE_URL=https://safir.bale.ai/api/v3

# Development: return OTP in API response when Bale keys are missing
ALLOW_DEV_OTP=true
