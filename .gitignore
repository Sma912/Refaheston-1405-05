# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# local npm cache
.npm-cache

# cached product images (downloaded once, then served locally)
/public/product-images/*
!/public/product-images/.gitkeep
# curated studio shots for tablets/consoles (committed for production)
!/public/product-images/extras/
!/public/product-images/extras/**

# typescript
*.tsbuildinfo

# convenience dump for pasting into SQL Editor (source of truth is migrations/)
/supabase/all-migrations-combined.sql
